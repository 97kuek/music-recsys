{
  "extends": "common.json",
  "experiment": {
    "name": "music4all-bpr-30epoch",
    "output": "../data/experiments/bpr/30epoch"
  },
  "model": {
    "name": "bpr",
    "parameters": {
      "learning_rate": 0.01,
      "regularization": 0.01,
      "memory_budget_mb": 4096,
      "use_gpu": true
    }
  },
  "search": {
    "stage": "B",
    "seeds": [42, 43, 44],
    "max_trials": 12,
    "grid": {
      "factors": [32, 64, 128, 256],
      "iterations": [30]
    }
  }
}
