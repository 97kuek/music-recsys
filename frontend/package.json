{
  "name": "music-recsys-ui",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/licenses.mjs && tsc --noEmit && vite build",
    "build:demo": "node scripts/licenses.mjs && tsc --noEmit && VITE_PUBLIC_DEMO=1 vite build --mode demo",
    "test": "node --experimental-strip-types --test --experimental-test-isolation=none tests/*.test.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "~5.9.3",
    "vite": "^8.0.0"
  },
  "license": "MIT"
}
