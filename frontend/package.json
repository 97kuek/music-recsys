{
  "name": "music-recsys-ui",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test:worker": "node --test tests/worker.test.mjs",
    "preview:cloudflare": "wrangler dev --env preview --ip 127.0.0.1",
    "deploy:preview": "npm run build:preview && wrangler deploy --env preview",
    "check:deploy": "npm run build:preview && wrangler deploy --env preview --dry-run --outdir /tmp/otolab-worker-check",
    "build:preview": "tsc --noEmit && VITE_PUBLIC_DEMO=1 vite build --mode preview"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "~5.9.3",
    "vite": "^8.0.0",
    "wrangler": "^4.151.1"
  }
}
